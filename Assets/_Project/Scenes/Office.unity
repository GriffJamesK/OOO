TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 21213862}
  m_Text: 'To whoever keeps turning

    the chair in 104 to face

    the wall: it belongs at

    Reception. It is not funny.

    It was not funny on

    Tuesday either.


    A.P.'
  m_OffsetZ: 0
  m_CharacterSize: 0.00954861
