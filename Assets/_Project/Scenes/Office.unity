  m_Name: 
  m_EditorClassIdentifier: Kit.Gameplay::Kit.Gameplay.Signage.WorldText
  text: 'To whoever keeps turning

    the chair in 104 to face

    the wall: it belongs at

    Reception. It is not funny.

    It was not funny on

    Tuesday either.


    A.P.'
  letterHeight: 0.011
  style: 0
  anchor: 4
