--- !u!114 &1913479430
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1913479426}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc57b083e8138494f9ce4a36631e7433, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Kit.Gameplay::Kit.Gameplay.Signage.WorldText
  text: 'FACILITIES NOTICE


    Room numbers in this building

    are under review.


    Two doors on L3 have been found

    carrying the same number. Until

    this is resolved, staff are asked

    not to re-letter doors themselves.

    Loose tiles to the cloakroom.


    G. Fenwick, Facilities

    2 November 1979'
  letterHeight: 0.017
  style: 0
  anchor: 4
