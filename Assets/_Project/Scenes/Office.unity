TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1624025163}
  m_Text: "FACILITIES DEPARTMENT  \xB7  MEMO\n\nRe: furniture on Stair B landings\n\nAn orange shell chair has been returned\nto the Waiting Room four times this\nquarter. Each following morning it has\nbeen found here on Level 6, facing the\nstairwell. Landings are to be kept clear.\n\nF. Mortimer, Facilities"
  m_OffsetZ: 0
  m_CharacterSize: 0.01736111
  m_LineSpacing: 1
  m_Anchor: 4
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 16
  m_FontStyle: 0
  m_RichText: 0
  m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
  m_Color:
    serializedVersion: 2
    rgba: 4294967295
