  m_GameObject: {fileID: 1637619862}
  m_Text: "FOUND AT RECEPTION\n\nglove, brown, left\nreading glasses,\n   tortoiseshell\numbrella, black\nkey ring, fob no. 104\n\nUnclaimed items go\nto Records on the 30th.\nA. Pell"
