  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1703110067}
  m_Text: 'FACILITIES NOTICE


    The balcony stair has been taken out.

    The balcony is closed until further notice

    and the railing will be made good.


    14 March 1977'
  m_OffsetZ: 0
  m_CharacterSize: 0.023148146
  m_LineSpacing: 1
