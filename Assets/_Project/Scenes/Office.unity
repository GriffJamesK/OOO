  m_Script: {fileID: 11500000, guid: dc57b083e8138494f9ce4a36631e7433, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Kit.Gameplay::Kit.Gameplay.Signage.WorldText
  text: 'OFFICE OF THE DIRECTOR OF CONTINUITY

    Re: Desk 3-114


    Three has not reconciled since Friday.

    Until it does, Facilities will go on numbering.

    Every door is to remain a door.

    Nothing is to be closed.


    T. Vane'
  letterHeight: 0.015
  style: 0
  anchor: 4
