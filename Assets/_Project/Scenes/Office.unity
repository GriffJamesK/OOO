TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 232503161}
  m_Text: 'LOST PROPERTY


    Umbrella, black, bamboo handle

    (lobby, 14 Feb)

    One glove, tan, left

    Reading glasses, green case

    Key on a blue tag marked B

    Cardigan, oatmeal (L3)


    Held at the cloakroom 30 days,

    then to Facilities.

    - W. Brisk, Front Desk'
  m_OffsetZ: 0
  m_CharacterSize: 0.014756944
  m_LineSpacing: 1
