TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 341653424}
  m_Text: 'LOST PROPERTY


    Umbrella, black, bamboo handle

    Cardigan, green (L.S.?)

    Reading glasses, tortoiseshell

    Thermos, tartan

    One key on a brass fob, no number


    Unclaimed items pass to

    Facilities after 30 days.'
  m_OffsetZ: 0
  m_CharacterSize: 0.01909722
  m_LineSpacing: 1
  m_Anchor: 4
